# ==============================================================================
#  SafeVision - example environment file
# ==============================================================================
#  Copy this file to `.env` and fill it in:
#
#      copy .env.example .env        (Windows cmd)
#      cp .env.example .env          (Linux / macOS)
#
#  `.env` is listed in .gitignore and must NEVER be committed.
#  `.env` is loaded by `main.py` at startup; real environment variables
#  (setx / export) always win over the values in this file, so you can
#  override anything without editing it.
# ==============================================================================

# ------------------------------------------------------------------------------
# DEMONSTRATION MODE
# ------------------------------------------------------------------------------
# The master switch for the automatic demonstration emergency call.
# While this is not `true`, SafeVision never places a call - not on a
# confirmed accident, not on anything else.
#
# Only set this to `true` when you are actually demonstrating the project.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# DEMONSTRATION RECIPIENT
# ------------------------------------------------------------------------------
# The ONE number the engine is authorised to call in demo mode.
#
#   * international E.164 format, e.g. +91XXXXXXXXXX (country code, then digits)
#   * this must be a number you own or have explicit permission to call
#   * it is read at runtime only; it is never written into Python source,
#     config.yaml, a log line or the debug overlay (those show a masked
#     form such as +91******3949)
EMERGENCY_CONTACT_NUMBER=+91XXXXXXXXXX

# ------------------------------------------------------------------------------
# TELEPHONY CREDENTIALS - OPTIONAL
# ------------------------------------------------------------------------------
# Leave these EMPTY for a fully offline demonstration: SafeVision then uses the
# simulation provider, which walks the same call-status lifecycle
# (INITIATED -> RINGING -> IN_PROGRESS -> COMPLETED, then SMS -> SENT) without
# placing a call or sending a message.
#
# Fill them in (Twilio) only if you want a real call / SMS to happen during the
# demo. With credentials present, `emergency.provider: auto` selects the live
# provider; without them it can never place a real call or send a real SMS.
#
# Create an account at https://www.twilio.com/try-twilio and note that a trial
# account can only call/message verified destination numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The Twilio number that sends the SMS (E.164, e.g. +1XXXXXXXXXX). Required for
# a real SMS; without it the SMS is simulated just like the call.
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# CAMERA (RTSP) CREDENTIALS - OPTIONAL
# ------------------------------------------------------------------------------
# Already honoured by SafeVision.  Keeping credentials out of the rtsp:// URL
# means they never reach a log file or the incident JSON.
# SAFEVISION_RTSP_USERNAME=
# SAFEVISION_RTSP_PASSWORD=
